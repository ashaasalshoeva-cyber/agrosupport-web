+"""Pair real NASA vs ground observations (CSV date,value). No silent imputation."""
+import csv,sys,math
+from pathlib import Path
+
+def read(path):
+ with open(path,newline='',encoding='utf-8-sig') as f:
+  return {row['date']:float(row['value']) for row in csv.DictReader(f)
+          if row.get('date') and row.get('value') not in (None,'')}
+
+def stats(a,b):
+ days=sorted(set(a)&set(b));pairs=[(a[d],b[d]) for d in days]
+ if not pairs:return None
+ err=[x-y for x,y in pairs];n=len(err)
+ bias=sum(err)/n;mae=sum(abs(x) for x in err)/n;rmse=math.sqrt(sum(x*x for x in err)/n)
+ ax=sum(x for x,y in pairs)/n;by=sum(y for x,y in pairs)/n
+ co=sum((x-ax)*(y-by) for x,y in pairs)
+ sx=sum((x-ax)**2 for x,y in pairs);sy=sum((y-by)**2 for x,y in pairs)
+ return {'n':n,'bias':bias,'mae':mae,'rmse':rmse,'correlation':co/math.sqrt(sx*sy) if sx>0 and sy>0 else None,'first':days[0],'last':days[-1]}
+
+if __name__=='__main__':
+ if len(sys.argv)!=3:raise SystemExit('Usage: python scripts/validate_power.py nasa.csv station.csv\nEach file must contain date,value. Only approved, real input data. No automatic data download.')
+ print(stats(read(sys.argv[1]),read(sys.argv[2])))
